{
  "name": "hph-vision",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test",
    "api:dev": "poetry run uvicorn hph_vision_api.main:app --app-dir packages/restapi/src --reload",
    "api:lint": "poetry run ruff check packages/api-core packages/restapi",
    "api:format": "poetry run ruff format packages/api-core packages/restapi",
    "api:test": "poetry run pytest packages/api-core/tests packages/restapi/tests",
    "mobile:dev": "turbo run dev --filter=hphvision",
    "mobile:lint": "turbo run lint --filter=hphvision"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@babel/preset-env": "^7.20.0",
    "@jest/globals": "^29.7.0",
    "@react-native/eslint-config": "0.75.3",
    "@types/jest": "^30.0.0",
    "babel-jest": "^29.6.3",
    "eslint": "^8.19.0",
    "jest": "^29.7.0",
    "jest-transform-stub": "^2.0.0",
    "ts-jest": "^29.4.11",
    "turbo": "^2.9.18",
    "typescript": "^5.8.0"
  }
}
