{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "strict": true,
    "declaration": true,
    "paths": {
      "@hiperhealth/hphvision-core": ["packages/hphvision-core/src"],
      "@hiperhealth/hphvision-core/*": ["packages/hphvision-core/src/*"],
      "@hiperhealth/hphvision-mobile": ["packages/hphvision-mobile/src"],
      "@hiperhealth/hphvision-mobile/*": ["packages/hphvision-mobile/src/*"],
      "@hiperhealth/hphvision-lib": ["packages/mobile-lib/src"],
      "@hiperhealth/hphvision-lib/*": ["packages/mobile-lib/src/*"]
    },
    "skipLibCheck": true
  }
}
